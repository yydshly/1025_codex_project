        "bytes": 87525,
        "sha256": "ffc9145f5bcda06f2c404ad47cd3f209574a1837bced85bad79e8802a6739ad5"
      }
    },
    "san-francisco-2025-01-15-tide-1": {
      "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-0-f6484dd574af.wav",
      "durationSeconds": 23.2,
      "text": "海水周期性地上涨、回落，就是潮汐。看地球和月球，月球对地球各处的引力不同。在这个简化模型里，青色海面在向月侧和背月侧都隆起。地球自转，金色的示意海岸点依次经过高低水位区，旁边的水位曲线同步起伏。太阳也参与引潮。",
      "sha256": "f6484dd574af309cc61b3f64025b8c9d7c6fbbbdc4a825689e3789892bc42ee7",
      "inputHash": "5a3d2b4370e3f86ca651fc109e497fec672694f61a3fa82240a5f6221321b787",
      "bytes": 1485964,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-0-f6484dd574af.mp3",
        "bytes": 139797,
        "sha256": "fc7e1b5be1f7e438ac9b16bbb6937bdb065e3dd37b2e5ba7cefc1dd899809d15"
      }
    },
    "san-francisco-2025-01-15-tide-2": {
      "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-2-cd0ca9912fcf.wav",
      "durationSeconds": 19.7,
      "text": "回到同一片浅滩。沿着金点看水线怎样向岸上移动。水升到高潮线时，浅滩被淹没，航道水深也增加。落潮时，水线退回，浅滩露出。接下来飞到旧金山港，用验潮记录看这里何时涨落。",
      "sha256": "cd0ca9912fcf0f8147c7ac0725de1ac5943463672bd4b0aa88991282da654a96",
      "inputHash": "ba9a5fcf2374ae8d313ea5c2a4ce89a1ad3923d5477f871cb71e237b33aceb82",
      "bytes": 1261964,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-2-cd0ca9912fcf.mp3",
        "bytes": 118845,
        "sha256": "b4ce4ccbd0af5904bea404014332da3d6e1be13d59bc0cecfdf72d2b34fce997"
      }
    },
    "san-francisco-2025-01-15-tide-3": {
      "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-2-f9ebae513a78.wav",
      "durationSeconds": 21.8,
      "text": "青色标记是旧金山验潮站。现在从地球靠近港口。月升和月落说的是月球越过地平线。港口是在涨潮还是落潮，要看验潮站的水位变化。接下来看二零二五年一月十五日的两组记录，岸边水线跟着实测涨落，右边另列预报。",
      "sha256": "f9ebae513a786af1107b0ca46f39cf816875ecf49163078e75c551133d397da0",
      "inputHash": "9fb5e2a4772063feb26c74e24bea9126b296e7e9476480c5f0b90de09ec0a659",
      "bytes": 1396364,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-2-f9ebae513a78.mp3",
        "bytes": 131373,
        "sha256": "54ca68da88bc3b0018df25506ec9850a543474537ff27c98fc0bc8ce3e0d5fb3"
      }
    },
    "san-francisco-2025-01-15-tide-4": {
      "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-1-3e6de81aef5b.wav",
      "durationSeconds": 14.5,
      "text": "先认准零度地平线。紫色标记从线下向上移动，越过地平线后变成亮色月球。到协调世界时二点十八分这笔星历，月球已经在地平线上方。",
      "sha256": "3e6de81aef5b9676f488d90d688a9c8529f77735676b62a1a80438b55763a43b",
      "inputHash": "c8f20fc06f36507d92c069756528ada1c1cda1e467fd99f94bf2c70b1364cb4e",
      "bytes": 929164,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-1-3e6de81aef5b.mp3",
        "bytes": 87525,
        "sha256": "f46a5e7d44fc8fe0679e4be51e6d22e153eb7f1802947233691715acb5b03168"
      }
    },
    "san-francisco-2025-01-15-tide-5": {
      "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-2-1aaae47b0f3b.wav",
      "durationSeconds": 14.4,
      "text": "沿紫色轨迹往前看，月球会经过南方高空，高度一度达到约七十二度。接着标记向西下降，到十六点四十八分这笔星历，月球已降到地平线下。",
      "sha256": "1aaae47b0f3b2bb6d82b9c7fc2eaa044ac2514ecf3c46e66fdd4a3dda2b89f17",
      "inputHash": "4bfd1099b694b777f1dbfe3bf2049fc6be83f6ff5dedc57e8876d4a6311b2ce9",
      "bytes": 922764,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-2-1aaae47b0f3b.mp3",
        "bytes": 86877,
        "sha256": "83776a94ae189b416ff7f0f7dbffb374192e39f2e4eb20331ad5c0c9ebe3ffc9"
      }
    },
    "san-francisco-2025-01-15-tide-6": {
      "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-3-3098a686d6a1.wav",
      "durationSeconds": 17.1,
      "text": "现在月球在地平线下，港口的潮位尺还在上升。青色实线是验潮站实测，金色虚线是调和预报。预报最高点在十九点四十二分，实测最高点在十九点五十四分。",
      "sha256": "3098a686d6a1d6abcfe05e10025b5aa5a07e305736d89f5072d9e6d15a405810",
      "inputHash": "e25d7702cede65794bf186c1a9168e47a79926d793cd3b0fb0ebc8b9812ee6b4",
      "bytes": 1095564,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-3-3098a686d6a1.mp3",
        "bytes": 103077,
        "sha256": "7751a38a32814502cfa898e1b9354dd771502a2549017e7b900b3bceb71e0c0c"
      }
    },
    "san-francisco-2025-01-15-tide-7": {
      "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-6-5e619affa84c.wav",
      "durationSeconds": 21.5,
      "text": "旧金山这一天，实测最低值早于月升。月球落到地平线以下时，水位仍在上涨。月球和太阳提供引潮作用，海水响应还受海盆和海岸形状影响。要判断这个港口何时涨落，请看右侧同一水位基准下的实测和预报曲线。",
      "sha256": "5e619affa84c949359800d075c6bae722e5cbec56de91300eb37b05814ec3ac7",
      "inputHash": "6726ed3cbfb151cb46e749648c4c6147cff567523aae057da569d5b1f35ab261",
      "bytes": 1377164,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-6-5e619affa84c.mp3",
        "bytes": 129645,
        "sha256": "ddc66133e2767d002d2023b059304b695d68311d75a90f6ea65a2b8612b62eee"
      }
    },
    "primer-volcano-0": {
      "url": "assets/narration/minimax/primer-volcano-0-f0c2cf4a6109.wav",
      "durationSeconds": 77.4,
      "text": "先把镜头拉远。汤加附近，太平洋板块向西沉到另一块板块下面，这叫俯冲。火山位于海沟以西，俯冲板块的上方。俯冲到深处时，板块里的含水矿物释放出水。水进入上方炽热的地幔，降低岩石开始熔融所需的温度。同样的温度下，部分岩石就能熔成岩浆。岩浆通常比周围的岩石轻，会受到向上的浮力。岩浆可以在地下暂时聚集。当压力足以撑开裂隙，就能沿裂隙继续上升。越靠近地表，岩浆受到的压力通常越低。原本溶在岩浆里的气体析出，变成气泡。气泡随减压膨胀，也会推动岩浆上升。通道连到地表或海底，岩浆和气体就可能喷出。气体容易逸出时，岩浆可以较平缓地流出。气体难以逸出时，膨胀可能把岩浆打碎，引发爆炸式喷发。这段动画解释汤加所在俯冲带的成因，以及火山喷发的一般过程。接下来，用两期测深找火山口的变化，再用当天的卫星红外图看云团展开。",
      "sha256": "f0c2cf4a610952d83c25c4bf5a6c9fe0decf01282da2a47c5fa103d8943769a5",
      "inputHash": "b8ef4a9e89849e4a2dfec66348c08160602de55e17b57237e9d4273faf97c2aa",
      "bytes": 4954764,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/primer-volcano-0-f0c2cf4a6109.mp3",
        "bytes": 464877,
        "sha256": "64499a0e9909c2c93f7c920fa08584eff84a88392423bd74887743c9bc8a20b2"
      }
    },
    "primer-storm-0": {
      "url": "assets/narration/minimax/primer-storm-0-83d290bf14d4.wav",
      "durationSeconds": 49.48090625,
      "text": "海面上先有一团雷雨扰动。暖海不断给近海面的空气补充热量和水汽，暖湿空气在雷雨区上升。水汽凝结放热，让上升持续。上升的空气在高空向外流散。流出的空气比低层补进的多时，海面气压就下降，周围空气继续向低压汇入。地球自转让这股气流在北半球向运动方向的右侧偏。俯视时，气流一边往里走，一边逆时针绕着低压中心转。赤道附近，这种偏转很弱。高低层的风速或风向差太大，雷雨就难围绕同一个中心组织起来。西北太平洋上的热带气旋达到台风强度，才叫台风。",
      "sha256": "83d290bf14d42aa096b66d46bb5937ae352c2325ad06db33af1c07770ac385db",
      "inputHash": "0d462966e8bec4af1ed844a8f0e4d5c28eb93c4299193b62456efe115b4df24e",
      "bytes": 3167942,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/primer-storm-0-83d290bf14d4.mp3",
        "bytes": 297477,
        "sha256": "3539d6af8a808f848192a206784a0361a217ec8598e663eed71cb73e710f5e63"
      }
    },
    "primer-quake-0": {
      "url": "assets/narration/minimax/primer-quake-0-886eabf12df1.wav",
      "durationSeconds": 41.7,
      "text": "板块一直在缓慢移动。断层是岩石中的破裂面。有的断层段被摩擦锁住，暂时滑不动。断层虽然卡住，两边较远的岩石仍在移动。像弯曲的尺子，断层附近的岩石逐渐变形，积累弹性能量。当应力超过断层能承受的阻力，卡住的一段突然滑动，破裂沿断层扩展。释放的一部分能量变成地震波，向外传开。传播更快的纵波先到，横波随后到。台站把地面的起伏记录成波形。接下来看真实记录，波开始到达和振幅最大是两个时刻。",
      "sha256": "886eabf12df14f44cbe46a847ce678a8658dabc5f179765ce7b5571ec84a86c3",
      "inputHash": "69b579ec869e253e0e48478fa048f7753423cb0b87af208b1d822708bd517bbe",
      "bytes": 2669964,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {
        "url": "assets/narration/minimax/primer-quake-0-886eabf12df1.mp3",
        "bytes": 250821,
        "sha256": "567dceaeda52d33c0498a52d24e48769c8ede9fcc40358ab00b9770d8710f858"
      }
    },
    "primer-wildfire-0": {
      "url": "assets/narration/minimax/primer-wildfire-0-74fb4c5a8f12.wav",
      "durationSeconds": 21.6,
      "text": "山火沿可燃植被传播，风能把热量带向下风方向，坡面也会影响火如何蔓延。植被的种类和湿度会改变燃烧条件。进入迪克西山火，先找新增边界，再分别核对附近风、坡度与植被。每条线索只说明其中一部分。",
      "sha256": "74fb4c5a8f1256db965b6350ed4200dacd5a8cf0b516d37538be895462b7b30a",
      "inputHash": "8d9854e23817f18dba4dce7623a25020f130504a1a48fc07fade18188e213168",
      "bytes": 1383564,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {

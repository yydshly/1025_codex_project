        "bytes": 130077,
        "sha256": "cff16b9c572b109c11d1724f6e8fcd7b2af42b4c650b7b38ccc343d4647fae29"
      }
    },
    "primer-river-0": {
      "url": "assets/narration/minimax/primer-river-0-47c2688141cd.wav",
      "durationSeconds": 20.6,
      "text": "水流把物质带向下游，物质也会逐渐分散开。同一时刻，河道不同位置的浓度可能不同。了解信号到达的先后，对下游取水监测很重要。我们用一次受控染料实验来看三个断面，辨认每个断面两岸什么时候测到信号。",
      "sha256": "47c2688141cde041a7cacc00058dc14bbe8cd23c8fc931c7360cb1cc85b446d8",
      "inputHash": "3e67f3f8599975eac7c794c52ad5c6c9c43b4b3c0c36dae2b650336780612a55",
      "bytes": 1319564,

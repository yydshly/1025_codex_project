    "san-francisco-2025-01-15-tide-0": {
      "url": "assets/narration/minimax/san-francisco-2025-01-15-tide-0-240fbe89166d.wav",
      "durationSeconds": 14.5,
      "text": "先看同一片浅滩。水退到低潮线，浅滩露出。水升到高潮线，浅滩被淹没。接下来从海岸拉远，看地球和月球怎样帮助我们理解这种周期性的变化。",
      "sha256": "240fbe89166d7ddc64b7fe0ff44ebff8364817ef11c6ae3be1b96f2f753caa79",
      "inputHash": "efe13355c5f2110cc44ceec5e5dad414fea648daebc4bf1604d065afa10d770f",
      "bytes": 929164,
      "sampleRate": 32000,
      "channels": 1,
      "bits": 16,
      "playback": {

# Dependencies and generated outputs; each project may add its own rules.
node_modules/
dist/
build/
coverage/
.next/
.nuxt/
.venv/
__pycache__/
*.pyc

# Local credentials; sanitized examples may be committed.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Local tools and operating system files.
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
